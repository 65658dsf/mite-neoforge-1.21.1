  "rules": [
    {
      "id": "damage_absolute",
      "evidence_status": "confirmed_static",
      "behavior": "非正伤害返回0；绝对伤害直接返回原值，不进入防御计算。",
      "evidence": {
        "file": ".reference/r196/decompiled/Damage.java",
        "method": "applyTargetDefenseModifiers"
      },
      "implementation_status": "planned"
    },
    {
      "id": "damage_blocking",
      "evidence_status": "confirmed_static",
      "behavior": "玩家格挡且伤害不绕过普通护甲时，伤害减半并至少为1；持有工具时另按格挡后伤害及工具战斗耗损系数损伤工具。",
      "evidence": {
        "file": ".reference/r196/decompiled/Damage.java",
        "method": "applyTargetDefenseModifiers"
      },
      "implementation_status": "planned"
    },
    {
      "id": "damage_defense",
      "evidence_status": "confirmed_static",
      "behavior": "总防御减去穿透附魔等级比例×5，最低0。通常生命伤害=max(格挡后伤害-有效防御,1)；护甲耐久损耗在生命伤害计算前处理。",
      "evidence": {
        "file": ".reference/r196/decompiled/Damage.java",
        "method": "applyTargetDefenseModifiers"
      },
      "implementation_status": "planned"
    },
    {
      "id": "damage_full_block",
      "evidence_status": "confirmed_static",
      "behavior": "目标为玩家且有效防御>=伤害时，进行 floor(有效防御-伤害)+1 次独立20%判定，任何一次成功则伤害为0。不能只用固定20%或原版百分比减伤替代。",
      "evidence": {
        "file": ".reference/r196/decompiled/Damage.java",
        "method": "applyTargetDefenseModifiers"
      },
      "implementation_status": "planned"
    },
    {
      "id": "armor_durability_defense",
      "evidence_status": "confirmed_static",
      "behavior": "非玩家装备拥有者固定取0.5防御倍率；玩家护甲仅剩最后耐久时为0；其余取min(2-2*damage/maxDamage,1)，使用该物品堆的品质相关maxDamage。",
      "evidence": {
        "file": ".reference/r196/decompiled/wh.java",
        "method": "getDamageFactor"
      },
      "implementation_status": "planned"
    },
