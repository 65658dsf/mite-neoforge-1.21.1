  "rules": [
    {
      "id": "crafting.recipe_difficulty",
      "behavior": "每配方按组件 getCraftingDifficultyAsComponent 依次 float 相加，随后可被 setDifficulty/scaleDifficulty 覆盖；真实计时用整批 difficulty，不能除以输出数量。",
      "details": [
        "缺失组件难度尝试已知最低制造难度或锈铁同类铜材料比例；仍未知则报错并跳过该组件，不可把这种旧降级行为当现代完整数据。",
        "高品质低品质输出不改变已存配方基础难度；品质在 CraftingResult 后续调整。",
        "动态配方/修复可能自行生成 CraftingResult，必须保留具体 recipe 类型与消费数量。"
      ],
