    {
      "id": "crafting.quality_and_xp_gate",
      "minimum_quality_java": "clamp(average.ordinal + ((level - (clumsiness ? 20 : 0)) / 10), 0, average.ordinal)",
      "negative_division": "Java int /10 向零截断；L=-9仍average，-10才poor，-20才wretched。",
      "skill_effect": "技能启用且不满足任一适用skillset时，最低品质取上述结果与poor较低者，最高品质只返回最低品质。无品质结果或zw染色配方不满足技能时直接不能制造。",
      "maximum_quality": "总经验<=0或不满足启用的技能时返回最低品质；否则从item.getMaxQuality往average以上倒序，选 getCraftingExperienceCost(qualityAdjustedDifficulty)<=totalXP 的最高品质，找不到则最低品质。",
      "potential_xp_cost_java": "Math.round(qualityAdjustedDifficulty / 5F) * (clumsiness ? 2 : 1)",
      "actual_xp_cost": "无品质、average或更低、或CraftingResult.is_experience_cost_exempt时为0；其余采用potential cost。",
