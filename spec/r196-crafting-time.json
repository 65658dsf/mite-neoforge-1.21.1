    {
      "id": "crafting.quality_difficulty",
      "formula": "D = baseDifficulty; for i in [0, quality.ordinal - average.ordinal): D = float(D * 2F)",
      "quality_ordinals": {
        "wretched": 0,
        "poor": 1,
        "average": 2,
        "fine": 3,
        "excellent": 4,
        "superb": 5,
        "masterwork": 6,
        "legendary": 7
      },
      "multipliers": {
        "null": 1,
        "wretched": 1,
        "poor": 1,
        "average": 1,
        "fine": 2,
        "excellent": 4,
        "superb": 8,
        "masterwork": 16,
        "legendary": 32
      },
      "quality_override": "非空 override 优先于传入品质。差品质不减少难度。",
