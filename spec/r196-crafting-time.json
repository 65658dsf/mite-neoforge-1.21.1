      "id": "crafting.food_pause_and_damage",
      "food_predicate": "getSatiation() + getNutrition() != 0",
      "food_effect": "只有 crafting_proceed && hasFoodEnergy 才 ++crafting_ticks；能量0时保留已有tick，恢复后继续，不乘1/5且不按缺失比例调整。",
      "damage_packet": "shortDamage = min(Math.round(float(amount * 10F)), 32767)",
      "damage_effect": "crafting_ticks = max(crafting_ticks - shortDamage * 5, 0)",
      "damage_amount_semantics": "amount 是 jv.onEntityDamaged 收到的伤害量；不是凭空假定攻击者的面板伤害。",
      "health_effect": "没有独立低血量减速倍率；死亡关闭界面和受伤回退另行作用。",
