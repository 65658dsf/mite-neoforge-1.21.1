  "modern_adaptations": [
    {
      "id": "healthy_textures",
      "decision": "Keep Minecraft1.21.1 native healthy wheat/carrot/potato/beetroot block models and textures; copy only source disease/death sprites."
    },
    {
      "id": "beetroot_disease_visuals",
      "decision": "R196 has no beetroot crop; retain modern age0..3 healthy stages, use source carrots blighted frames0..3 and dead frames0..2, dead age3 clamps to2."
    },
    {
      "id": "fertilized_farmland",
      "decision": "Use source top sprites for fertilized dry/wet soil, modern native dirt sides and template_farmland shape. Native unamended model names remain and wetness>0 selects moist source semantics."
    },
    {
      "id": "agricultural_enchantment_cost",
      "decision": "Source has only minimum effective budgets1/11/21/31/41. Modern max_cost constant2147483647 represents absent upper bound; Enchantment.Cost.CODEC uses Codec.INT. Anvil cost2 and slotmainhand are explicit modern repair/equipment adaptations."
    },
    {
      "id": "modern_hoes",
      "decision": "Agricultural supported_items includes source HOE/MATTOCK/SCYTHE families and all six native modern hoes; no exclusive_set is added."
    },
    {
      "id": "beetroot_loot",
      "decision": "Keep native nonmature seed and mature beetroot plus1+Binomial(3,.5714286) seeds without Fortune enrichment; disease/dead loot is empty."
    },
    {
      "id": "onion_resources",
      "decision": "Existing source onion models, sprites, stateproperty names and2+Bernoulli(.25) loot JSON already implement source visual/base-yield mapping; reuse without generating a duplicate main/generated resource path."
    },
    {
      "id": "melon_loot",
      "decision": "Source normal melon gives exactly4slices without Fortune; Silk Touch keeps whole melon. Dedicated fruit destruction context overrides explosion yields with source1melon seed and is not encoded as random loot decay."
    },
    {
      "id": "farmland_snow_support",
      "decision": "Append nativefarmland to minecraft:snow_layer_can_survive_on to compensate for modern15/16collision; R196aof provides a full cube collision and source snowfall may replace crops on it. Native precipitation/climate/accumulation checks remain authoritative."
    }
  ],
  "coverage": [
    "All source wheat8blighted/7dead, carrot4blighted/3dead and potato4blighted/3dead PNGs copied byte-for-byte.",
    "Modern blockstate mappings explicitly cover all age×blighted×dead combinations including unreachable dead mature ages safely.",
    "Enchantment distribution tag names checked against official local1.21.1 client data: in_enchanting_table,tradeable,on_random_loot,non_treasure.",
    "Loot JSON controls base item/count; root server crop harvest context controls cause-of-destruction eligibility and adds effective Harvesting extra units."
  ],
