  "source_rules": {
    "registration": [
      "yc.java:28-29 iron/gold ingots",
      "yc.java:116 gold nugget",
      "yc.java:158-168 other nuggets and ingots"
    ],
    "stack_and_difficulty": [
      "ItemIngot.java:6-15 stack8 and material.durability*100F",
      "ItemNugget.java:4-11 stack64 and ingot component difficulty/9F"
    ],
    "conversions": [
      "aae.java:5-6 arrays and full 3x3 nugget pattern",
      "aae.java:16-50 shaped packing and shapeless unpacking registration"
    ],
    "workbench": {
      "sources": [
        "RecipeHelper.java:59-63 ItemIngot early return before bench-grade test"
      ],
      "rule": "ItemIngot and its ItemNugget subclass do not require a metal-grade workbench. Nine-nugget packing still needs physical 3x3 grid space; ingot unpacking fits 2x2."
    },
    "experience": {
      "sources": [
        "yc.java:1193-1194 hasQuality defaults false",
        "wd.java:285-287 no-quality output has zero crafting XP cost"
      ],
      "crafting_xp_cost": 0,
      "crafting_xp_award": 0,
      "note": "The item xp_reward scalar is furnace/output XP metadata, not a nugget-conversion reward."
    },
    "skills": {
      "source": "wd.java:152 world.areSkillsEnabled gate",
      "rule": "Packing records BLACKSMITHING bit256 but the release runtime snapshot has professions_suppressed=true; do not claim a default mandatory profession gate."
    },
    "timing": {
      "sources": [
        "bex.java:450-457 difficulty compression",
        "bex.java:497-503 minimum period and level/bench/speed effects"
      ],
      "base_function": "D<25 ->25; D>100 ->round(pow(D-100F,0.8F))+100; otherwise round(D)",
      "implemented_this_batch": false,
      "note": "Modern conversion remains instant until the shared timed-crafting feature is integrated. Runtime difficulty is retained here as evidence, not silently treated as zero."
    }
  },
  "modern_compatibility": {
    "original_item_identity_preserved": [
      "minecraft:copper_ingot",
      "minecraft:iron_ingot",
