    ],
    "default_component_patch": "Only MAX_STACK_SIZE of copper/iron/gold ingots becomes8; all other components are preserved. New ingots use8 and all nuggets64.",
    "vanilla_recipe_overrides": [
      "minecraft:iron_ingot_from_nuggets",
      "minecraft:gold_ingot_from_nuggets",
      "minecraft:iron_nugget",
      "minecraft:gold_nugget"
    ],
    "bulk_recipe_reason": "Vanilla crafting serializers use ItemStack.STRICT_CODEC and reject nine ingots when max stack is eight. A dedicated single-input recipe accepts exactly count9 of these seven ingot identities with maxstack8, remains in the crafting book, and preserves the nine-for-one conversion.",
    "bulk_recipe_serializer": "mite:bulk_material",
    "existing_bulk_recipe_overrides": [
      "minecraft:copper_ingot",
      "minecraft:copper_ingot_from_waxed_copper_block",
      "minecraft:iron_ingot_from_iron_block",
      "minecraft:gold_ingot_from_gold_block"
    ],
    "bulk_transfer_boundary": "Result/cursor may transiently hold the whole batch9; storage slots split to at most8. Scoped native-menu Mixins recognize the actual BulkMaterialRecipe: Shift repeats the existing inventory transfer until empty or no progress; empty hotbar/offhand swaps store8 then add/drop the remaining1 while leaving original onTake/count intact. Full inventories preserve vanilla no-move or partial-transfer/remainder-drop semantics. Creative mode also retains the ninth ingot rather than silently deleting it.",
    "waxed_copper": "Retained modern copper-block compatibility, not an R196 block form.",
    "bulk_transfer_sources": [
      "BulkMaterialTransfers.isBulkResult: real native menu, actual current recipe type and same result components",
      "InventoryMenu.quickMoveStack: first moveItemStackTo call only",
      "CraftingMenu.quickMoveStack: first moveItemStackTo call only",
      "AbstractContainerMenu.doClick: first Inventory.setItem call, the empty-target SWAP branch only",
      "CrafterBlock.dispenseItem: vanilla already uses unit insertion when batch exceeds target stack limit"
    ]
  },
